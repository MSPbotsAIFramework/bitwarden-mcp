# ─── Bitwarden Organization API Key ──────────────────────────────────────────
# Required when AUTH_MODE=env (local dev only, single shared credential set).
# Generate in Admin Console: Settings → Organization info → API Key.
# Requires a paid organization plan (Teams/Enterprise) — free personal accounts
# have no organization and cannot use the Public API.
BITWARDEN_CLIENT_ID=organization.your_client_id_here
BITWARDEN_CLIENT_SECRET=your_client_secret_here

# Optional: override for EU Cloud or self-hosted instances.
# EU Cloud:      BITWARDEN_API_URL=https://api.bitwarden.eu
#                BITWARDEN_IDENTITY_URL=https://identity.bitwarden.eu
# Self-hosted:   BITWARDEN_API_URL=https://your.domain.com/api
#                BITWARDEN_IDENTITY_URL=https://your.domain.com/identity
BITWARDEN_API_URL=https://api.bitwarden.com
BITWARDEN_IDENTITY_URL=https://identity.bitwarden.com

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) credentials provided per-request via HTTP
#             headers: x-bitwarden-client-id, x-bitwarden-client-secret, and the
#             optional x-bitwarden-api-url / x-bitwarden-identity-url region overrides.
#             Required for production / multi-tenant deployments (e.g. behind mcp-gateway).
#             No credential or token is cached across requests — each call exchanges
#             its own short-lived access_token (1h TTL, not reused).
# "env"     — (local dev only) single credential set loaded from BITWARDEN_CLIENT_ID /
#             BITWARDEN_CLIENT_SECRET environment variables.
#             NOT SOP-compliant: credentials are shared across all requests; do not use in production.
AUTH_MODE=gateway
